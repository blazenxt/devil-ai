# Devil AI — basic security

Options -Indexes -MultiViews

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect direct old-host access to the canonical domain. Only our Cloudflare Worker may use the
  # old host directly: it sends a secret X-Devil-Origin-Key (filled in by the deploy workflow from a
  # GitHub secret). Anyone hitting the server directly gets a cheap redirect and never reaches PHP.
  RewriteCond %{HTTP:X-Devil-Origin-Key} !^__DEVIL_ORIGIN_KEY__$
  RewriteCond %{HTTP_HOST} ^(?:www\.)?blazepanel\.mywp\.info$ [NC]
  RewriteRule ^(.*)$ https://ai.devil.blazenxt.com/$1 [R=302,L,NE]

  # Preserve Authorization header for PHP/FastCGI developer API
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Block direct browser access to the data/ folder (config.json etc.)
  RewriteRule ^data/ - [F,L]

  RewriteRule ^auth/github/callback/?$ login.php?github_callback=1 [L,QSA]

  # AI Mode home: /chat (app.php itself is never shown — app.php redirects to /chat)
  RewriteRule ^chat/?$ app.php [L,QSA]

  # Pretty chat URLs: /chat/{model}/{type}/{128-char-slug}
  RewriteRule ^chat/([A-Za-z0-9-]+)/([A-Za-z0-9-]+)/([A-Fa-f0-9]{128})/?$ app.php?route_model=$1&route_type=$2&chat=$3 [L,QSA]

  # Sandbox file viewer: /sbx-view/{signed-token}/{path inside the sandbox}
  RewriteRule ^sbx-view/([a-z0-9.]{40,90})/(.*)$ api.php?action=sbx_view&t=$1&p=$2 [L,QSA,B]

  # Agent Mode URLs: /agent (new agent chat) and /agent/{128-char-slug}
  RewriteRule ^agent/?$ app.php?mode=agent [L,QSA]
  RewriteRule ^agent/([A-Fa-f0-9]{128})/?$ app.php?mode=agent&chat=$1 [L,QSA]

  # Battle modes: /battle, /battle/{slug}, /side-by-side, /side-by-side/{slug}
  RewriteRule ^battle/?$ app.php?mode=battle [L,QSA]
  RewriteRule ^battle/([A-Fa-f0-9]{128})/?$ app.php?mode=battle&chat=$1 [L,QSA]
  RewriteRule ^side-by-side/?$ app.php?mode=sbs [L,QSA]
  RewriteRule ^side-by-side/([A-Fa-f0-9]{128})/?$ app.php?mode=sbs&chat=$1 [L,QSA]

  # Developer API (OpenAI-compatible)
  RewriteRule ^v1/models/?$ api.php?action=dev_models [L,QSA]
  RewriteRule ^v1/chat/completions/?$ api.php?action=dev_chat_completions [L,QSA]

  # Pretty share URLs: /share/{128-char-share-id} (old share.php?id=... remains supported)
  RewriteRule ^share/([A-Za-z0-9_-]{8,160})/?$ share.php?id=$1 [L,QSA]
</IfModule>
